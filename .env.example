# Variables de entorno de SINTONÍA
#
# Copia este archivo como .env.local (en tu ordenador) o añade estas
# variables en Vercel (Settings > Environment Variables).
# Nunca subas a GitHub un archivo con valores reales.

# ---------------------------------------------------------------------------
# Supabase (Project Settings > API)
# ---------------------------------------------------------------------------

# Dirección del proyecto. Ejemplo: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Clave pública ("anon"). No es secreta: los permisos los decide la base de datos.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Modos especiales
# ---------------------------------------------------------------------------

# "true" solo en la instalación de demostración (datos ficticios). Fase 7.
VITE_MODO_DEMO=false

# "true" solo al trabajar en local con el servidor que imita a Supabase.
VITE_ENTORNO_LOCAL=false

# ---------------------------------------------------------------------------
# Solo para el desarrollo local (npm run local:db)
# ---------------------------------------------------------------------------

# Conexión al PostgreSQL local donde se crean las bases de datos de prueba.
LOCAL_PG_URL=postgresql://postgres:postgres@localhost:5432/postgres
