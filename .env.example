# Variables de entorno de SINTONÍA
#
# Copia este archivo como .env.local (en tu ordenador) o añade estas
# variables en Vercel (Settings > Environment Variables).
# Nunca subas a GitHub un archivo con valores reales.

# ---------------------------------------------------------------------------
# Supabase (Project Settings > API)
# ---------------------------------------------------------------------------

# Dirección del proyecto. Ejemplo: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Clave pública ("anon"). No es secreta: los permisos los decide la base de datos.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Modos especiales
# ---------------------------------------------------------------------------

# "true" solo en la instalación de demostración (datos ficticios). Fase 7.
VITE_MODO_DEMO=false

# "true" solo al trabajar en local con el servidor que imita a Supabase.
VITE_ENTORNO_LOCAL=false

# ---------------------------------------------------------------------------
# Solo para el desarrollo local (npm run local:db)
# ---------------------------------------------------------------------------

# Conexión al PostgreSQL local donde se crean las bases de datos de prueba.
LOCAL_PG_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Solo en el servidor (Vercel). NUNCA con el prefijo VITE_: no deben llegar al navegador.
# ---------------------------------------------------------------------------

# Dirección del proyecto de Supabase (la misma que VITE_SUPABASE_URL).
SUPABASE_URL=

# Clave de servidor de Supabase ("service_role", en Project Settings > API).
# Es secreta: permite el cierre de semana (sorteo y agenda).
SUPABASE_SERVICE_ROLE_KEY=

# Clave que protege el cierre automático de cada semana. Vercel la envía al
# llamar a /api/cerrar-semana. Genera una con: openssl rand -hex 32
CRON_SECRET=

# Agenda de tutoría: "banco" (preguntas escritas de antemano, por defecto)
# o "modelo" (las redacta un modelo de lenguaje; si falla, se usa el banco).
AGENDA_MODO=banco

# Solo si AGENDA_MODO=modelo: clave de la API de Anthropic y modelo.
ANTHROPIC_API_KEY=
AGENDA_MODELO=claude-opus-5-5

# ---------------------------------------------------------------------------
# Correos (recordatorios y avisos de apoyo). Solo en el servidor.
# ---------------------------------------------------------------------------

# Dirección pública de la aplicación, para los enlaces de los correos.
# Ejemplo: https://sintonia.vercel.app
APP_URL=

# "resend" (envía de verdad), "consola" (solo los escribe en el registro) o "ninguno".
CORREO_PROVEEDOR=consola

# Solo con CORREO_PROVEEDOR=resend:
RESEND_API_KEY=
# [PENDIENTE: remitente de los correos]. Ejemplo: SINTONÍA <sintonia@tu-dominio.es>
CORREO_REMITENTE=

# Dirección que recibe los mensajes del formulario de contacto (por defecto, ferca@usal.es).
CORREO_CONTACTO=
