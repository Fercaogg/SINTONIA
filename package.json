{
  "name": "sintonia",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "SINTONÍA: registro semanal de estudiante y tutor para acompañar trabajos académicos sin vigilar.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "local:db": "vite-node scripts/local/preparar-bd.mjs",
    "local:servidor": "node scripts/local/servidor-local.mjs",
    "local:tareas": "vite-node scripts/local/tareas-diarias.mjs",
    "demo:local": "vite-node scripts/demo/crear-demo.mjs",
    "demo:remoto": "vite-node scripts/demo/crear-demo.mjs -- --remoto",
    "demo:servidor": "LOCAL_BD=sintonia_demo node scripts/local/servidor-local.mjs",
    "demo:app": "vite --mode demo",
    "test": "vitest run",
    "pdf": "node scripts/generar-pdf.mjs",
    "test:bd": "vitest run tests/bd",
    "test:e2e": "playwright test --trace off",
    "sql:unir": "node scripts/unir-sql.mjs",
    "rendimiento": "node scripts/medir-rendimiento.mjs",
    "test:demo": "playwright test --config playwright.demo.config.ts --trace off",
    "capturas": "CAPTURAS=1 playwright test --config playwright.demo.config.ts --trace off",
    "clips": "CLIPS=1 playwright test --config playwright.demo.config.ts --project escritorio --trace off && bash scripts/convertir-clips.sh",
    "typecheck": "vue-tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "pg": "^8.23.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "jsonwebtoken": "^9.0.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^2.2.12"
  }
}
