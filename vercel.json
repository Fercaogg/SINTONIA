{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/((?!api/|robots\\.txt$|sitemap\\.xml$|og\\.png$|favicon\\.svg$|assets/|clips/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://skzpyzawkhwovfbgnuep.supabase.co wss://skzpyzawkhwovfbgnuep.supabase.co; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/((?!api/|robots\\.txt$|sitemap\\.xml$|og\\.png$|favicon\\.svg$|assets/|$|como-funciona$|acceso$|registro$|privacidad$|aviso-legal$|cookies$|consentimiento$|investigacion$|demo$|demo/recorrido$|seguridad$|accesibilidad$|novedades$|estado$).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cerrar-semana",
      "schedule": "15 23 * * *"
    },
    {
      "path": "/api/recordatorios",
      "schedule": "15 7 * * *"
    },
    {
      "path": "/api/reiniciar-demo",
      "schedule": "30 2 * * *"
    }
  ],
  "functions": {
    "api/instalar.ts": {
      "includeFiles": "supabase/*.sql",
      "maxDuration": 120
    },
    "api/reiniciar-demo.ts": {
      "maxDuration": 300
    }
  }
}
