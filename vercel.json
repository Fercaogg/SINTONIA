{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/(como-funciona|investigacion|instituciones|demo|demo/recorrido|seguridad|accesibilidad|novedades|estado|hoja-de-ruta|participantes|privacidad|aviso-legal|cookies|consentimiento|acceso|registro|en|en/how-it-works|en/research|en/institutions|en/security|en/accessibility|en/roadmap|en/status|en/changelog)",
      "destination": "/$1.html"
    },
    {
      "source": "/(acceso/confirmar|consentimiento/aceptar|dosier/imprimir|estudiante|tutor|direccion|investigador|calendario|cuenta)",
      "destination": "/index.html"
    },
    {
      "source": "/(estudiante|tutor|direccion|investigador|calendario|cuenta|og|participantes/imprimir)/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://skzpyzawkhwovfbgnuep.supabase.co wss://skzpyzawkhwovfbgnuep.supabase.co; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(clips|og|kit|dosier)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|favicon\\.ico|apple-touch-icon\\.png|icono-192\\.png|icono-512\\.png|icono-maskable-512\\.png|site\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/((?!api/|robots\\.txt$|sitemap\\.xml$|og\\.png$|favicon\\.svg$|favicon\\.ico$|icono-[a-z0-9-]+\\.png$|site\\.webmanifest$|apple-touch-icon\\.png$|_vercel/|assets/|clips/|kit/|dosier/|og/|$|como-funciona$|investigacion$|instituciones$|demo$|demo/recorrido$|seguridad$|accesibilidad$|novedades$|estado$|hoja-de-ruta$|participantes$|privacidad$|aviso-legal$|cookies$|consentimiento$|acceso$|registro$|en$|en/how-it-works$|en/research$|en/institutions$|en/security$|en/accessibility$|en/roadmap$|en/status$|en/changelog$).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cerrar-semana",
      "schedule": "15 23 * * *"
    },
    {
      "path": "/api/recordatorios",
      "schedule": "15 7 * * *"
    },
    {
      "path": "/api/reiniciar-demo",
      "schedule": "30 2 * * *"
    }
  ],
  "functions": {
    "api/instalar.ts": {
      "includeFiles": "supabase/*.sql",
      "maxDuration": 120
    },
    "api/reiniciar-demo.ts": {
      "maxDuration": 300
    }
  },
  "cleanUrls": false
}
