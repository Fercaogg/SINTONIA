{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cerrar-semana",
      "schedule": "15 23 * * *"
    },
    {
      "path": "/api/recordatorios",
      "schedule": "15 7 * * *"
    }
  ]
}